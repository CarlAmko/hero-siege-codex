# Local secrets for hs-social. Copy to .env (gitignored) — never commit it.
#
# The credential is resolved in this order: --token, HS_SOCIAL_TOKEN, then the
# local Discord client's stored session. Prefer the client session; only paste
# a token here if you must. A user-session token is a self-bot: read-only, your
# own account, and Discord's ToS prohibits automating it.
#
# Load it with Node's env-file flag:
#   node --env-file=.env bin/hs-social.js stats
HS_SOCIAL_TOKEN=
# auto | user | bot
HS_SOCIAL_AUTH=
