{
  "name": "hero-siege-codex",
  "version": "1.0.0",
  "description": "Hero Siege Economy & Fast Item Price-Check Triage Tool",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "hs-economy": "./bin/hs-economy.js",
    "hs-social": "./bin/hs-social.js",
    "hs-social-mcp": "./bin/hs-social-mcp.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "check": "node bin/hs-economy.js check",
